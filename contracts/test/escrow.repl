(env-data { "admin-keyset": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" },
            "ops-keyset": { "keys": ["bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"], "pred": "keys-all" },
            "recipient-keyset": { "keys": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"], "pred": "keys-all" },
            "sponsor": "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" })
(env-keys ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"])
(env-chain-data { 'block-time: (time "2026-10-04T10:00:00Z") })
(begin-tx)
(load "vendor/fungible-v2.pact")
(load "vendor/fungible-xchain-v1.pact")
(load "vendor/coin.pact")
(create-table coin.coin-table)
(create-table coin.allocation-table)
(load "../escrow.pact")
(commit-tx)
(begin-tx)
(coin.create-account "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" (read-keyset "admin-keyset"))
(test-capability (coin.COINBASE))
(coin.coinbase "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" (read-keyset "admin-keyset") 10.0)
(env-sigs [{ 'key: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 'caps: [(kadena-earn.GOVERNANCE), (coin.TRANSFER "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" "kadena-earn-escrow" 0.3)] }])
(kadena-earn.create-and-fund "campaign" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" 0.1 3 (time "2026-10-04T11:00:00Z"))
(expect "Prefunds exact pool" 0.3 (at 'funded (kadena-earn.get-campaign "campaign")))
(expect-failure "Duplicate campaign cannot debit twice" (kadena-earn.create-and-fund "campaign" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" 0.1 3 (time "2026-10-04T11:00:00Z")))
(commit-tx)
(env-keys ["bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"])
(begin-tx)
(expect-failure "Operations cannot withdraw directly from escrow" (coin.transfer "__ESCROW_ACCOUNT__" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" 0.01))
(expect-failure "Escrow capability cannot be acquired outside its module" (with-capability (kadena-earn.OPS) (with-capability (kadena-earn.ESCROW) (coin.transfer "__ESCROW_ACCOUNT__" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" 0.01))))
(commit-tx)
(env-sigs [{ "key": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "caps": [(kadena-earn.OPS)] }])
(begin-tx)
(expect-failure "Operations cannot pause" (kadena-earn.set-global-pause true))
(expect-failure "Operations cannot fund" (kadena-earn.create-and-fund "bad" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" 0.1 1 (time "2026-10-04T11:00:00Z")))
(expect-failure "Refund before deadline fails" (kadena-earn.refund-unused "campaign"))
(kadena-earn.reserve-claim "campaign" "proof-1" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
(kadena-earn.reserve-claim "campaign" "proof-2" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
(kadena-earn.reserve-claim "campaign" "proof-3" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
(expect-failure "Cannot reserve more slots than funded" (kadena-earn.reserve-claim "campaign" "proof-4" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
(kadena-earn.pay-reward "campaign" "proof-1" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
(expect-failure "Cannot pay the same proof twice" (kadena-earn.pay-reward "campaign" "proof-1" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
(expect-failure "Cannot pay unreserved proof" (kadena-earn.pay-reward "campaign" "unknown" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
(expect-failure "Cannot change recipient" (kadena-earn.pay-reward "campaign" "proof-2" "k:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"))
(commit-tx)
(env-keys ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"])
(begin-tx)
(kadena-earn.set-global-pause true)
(commit-tx)
(env-sigs [{ "key": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "caps": [(kadena-earn.OPS)] }])
(begin-tx)
(expect-failure "Pause blocks payout" (kadena-earn.pay-reward "campaign" "proof-2" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
(expect-failure "Pause blocks new reservations" (kadena-earn.reserve-claim "campaign" "blocked" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
(commit-tx)
(env-keys ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"])
(begin-tx)
(expect-failure "Pause blocks new funding" (kadena-earn.create-and-fund "paused" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" 0.1 1 (time "2026-10-04T11:00:00Z")))
(kadena-earn.set-global-pause false)
(commit-tx)
(env-chain-data { 'block-time: (time "2026-10-04T12:00:00Z") })
(env-sigs [{ "key": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "caps": [(kadena-earn.OPS)] }])
(begin-tx)
(expect-failure "No new reservations after deadline" (kadena-earn.reserve-claim "campaign" "late" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
(expect-failure "Reserved rewards cannot be refunded" (kadena-earn.refund-unused "campaign"))
(kadena-earn.pay-reward "campaign" "proof-2" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
(expect "Late approval is payable" 0.2 (at 'paid (kadena-earn.get-campaign "campaign")))
(kadena-earn.release-claim "campaign" "proof-3")
(commit-tx)
(begin-tx)
(expect "Only unused reward is refunded" 0.1 (kadena-earn.refund-unused "campaign"))
(expect-failure "Refund cannot run twice" (kadena-earn.refund-unused "campaign"))
(expect-failure "Rejected claim cannot be paid" (kadena-earn.pay-reward "campaign" "proof-3" "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"))
(expect "Paid count stays within slots" 2 (at 'paid-count (kadena-earn.get-campaign "campaign")))
(expect "Accounting conserves pool" 0.3 (+ (at 'paid (kadena-earn.get-campaign "campaign")) (at 'refunded (kadena-earn.get-campaign "campaign"))))
(expect "Escrow drained only by rewards and refund" 0.0 (coin.get-balance "__ESCROW_ACCOUNT__"))
(commit-tx)
