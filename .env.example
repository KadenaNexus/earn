NODE_ENV=production
PORT=3035
APP_ORIGIN=https://earn.example.com
DATABASE_URL=postgres://kadena_earn:REPLACE_ME@127.0.0.1:5432/kadena_earn
ADMIN_ACCOUNT=k:d70371113e84a5e5216c2a24b7e245049712d2c3f0d93ac77a40caf37f0f8d75
KADENA_NETWORK_ID=mainnet01
KADENA_CHAIN_ID=1
KADENA_NODE_URL=https://api.chainweb-community.org
# Set to the exact namespace.module deployed after independent review.
PACT_MODULE=
OPS_PUBLIC_KEY=
OPS_SECRET_KEY=
OPS_ACCOUNT=
CONTRACT_REVIEW_CONFIRMED=false
ENABLE_CHAIN_WRITES=false
# Temporary owner-only installation and 0.05 KDA gas funding; ordinary writes stay off.
ENABLE_CONTRACT_SETUP=false
CONFIRMATION_DEPTH=6
GAS_PRICE=0.0000001
WORKER_INTERVAL_MS=10000
SESSION_HOURS=24
# PM2 backups use native PostgreSQL client tools and keep verified dumps for 14 days.
BACKUP_DIRECTORY=./backups
# Native PostgreSQL 17 tools; change only if installed elsewhere.
PG_BIN_DIRECTORY=/usr/lib/postgresql/17/bin
# Optional: export EARN_NODE_BIN=/absolute/path/to/node before starting PM2 (Node 22+).
# AI review agent (optional). Only campaigns marked "AI review" are reviewed, and the
# owner switch in Admin starts off. The agent approves or requests changes, never rejects.
ANTHROPIC_API_KEY=
AI_REVIEW_MODEL=claude-sonnet-5-5
# Largest reward per task the agent may approve and pay, and its rolling 24-hour total.
AI_REVIEW_MAX_REWARD_KDA=1
AI_REVIEW_DAILY_KDA=10
# Below this confidence the submission goes to the owner instead.
AI_REVIEW_MIN_CONFIDENCE=0.8
# Change-request rounds before the owner takes over.
AI_REVIEW_MAX_ROUNDS=2
# Kadena Nexus Games (games.html). Game wins have their own AI payout limits,
# separate from tasks: largest prize per win the agent may pay, and its rolling 24-hour total.
GAMES_MAX_REWARD_KDA=5
GAMES_DAILY_KDA=50
GAMES_WINS_PER_WALLET_PER_DAY=1
GAMES_ATTEMPTS_PER_ROUND=3
# Require a confirmed email (one inbox per wallet) to play for KDA. Off by default;
# turning it on needs the Resend settings below (same Resend account as the other Nexus apps).
GAMES_REQUIRE_EMAIL=false
RESEND_API_KEY=
EMAIL_FROM=Kadena Earn <alerts@kadena.ws>
